# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=sijan
PRIVATE_STORAGE_KEY=generate-a-fernet-key-with-python
DATA_DIR=instance
MAX_UPLOAD_MB=250
COOKIE_SECURE=0
# Set in production (also set APP_ENV=production, COOKIE_SECURE=1)
# ADMIN_PASSWORD_HASH=generate-with-werkzeug-or-set-a-strong-ADMIN_PASSWORD-on-first-run
# DATABASE_PATH=/var/lib/sijan-store/sijan_store.sqlite3
# DATA_DIR=/var/lib/sijan-store
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
