let allApps=[],allDns=[],filter='all',featuredIndex=0;
const tr=k=>words[document.documentElement.lang||'en'][k]||words.en[k]||k;
function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
let particleFrame=0,bootStarted=0,bootProgress=1,bootProgressTimer=0;
function startBootParticles(){
 const canvas=document.getElementById('bootParticles');if(!canvas)return;const ctx=canvas.getContext('2d');if(!ctx)return;const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;let w=0,h=0,dots=[];
 const resize=()=>{const dpr=Math.min(devicePixelRatio||1,2);w=innerWidth;h=innerHeight;canvas.width=w*dpr;canvas.height=h*dpr;canvas.style.width=w+'px';canvas.style.height=h+'px';ctx.setTransform(dpr,0,0,dpr,0,0);dots=Array.from({length:Math.min(95,Math.max(35,Math.floor(w*h/15000)))},()=>({x:Math.random()*w,y:Math.random()*h,r:Math.random()*1.6+.45,vx:(Math.random()-.5)*.13,vy:(Math.random()-.5)*.13,red:Math.random()<.2,alpha:.25+Math.random()*.6}))};
 const draw=()=>{ctx.clearRect(0,0,w,h);for(const p of dots){ctx.beginPath();ctx.fillStyle=p.red?`rgba(239,41,74,${p.alpha})`:`rgba(235,237,245,${p.alpha})`;ctx.shadowBlur=p.r>1.4?8:0;ctx.shadowColor=p.red?'#ef294a':'#fff';ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();if(!reduced){p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1}}if(!reduced)particleFrame=requestAnimationFrame(draw)};resize();addEventListener('resize',resize);draw();
}
function setBootProgress(value){bootProgress=Math.max(1,Math.min(100,value));const bar=document.querySelector('.loader-progress-track i'),label=document.getElementById('bootProgressText');if(bar)bar.style.width=`${bootProgress}%`;if(label)label.textContent=`${Math.floor(bootProgress)}%`}
function finishBootLoader(connected){const loader=document.getElementById('bootLoader');if(!loader)return;clearInterval(bootProgressTimer);setBootProgress(100);document.getElementById('bootState').textContent=connected?'READY':'OFFLINE';document.getElementById('bootMessage').textContent=connected?'Published catalogue is ready.':'Could not connect; showing available page content.';setTimeout(()=>{loader.classList.add('is-exiting');cancelAnimationFrame(particleFrame);setTimeout(()=>loader.remove(),700)},Math.max(0,1650-(performance.now()-bootStarted)))}
function renderFeatured(){
 const stage=document.getElementById('featuredStage'),dots=document.getElementById('featuredPagination');
 if(!allApps.length){stage.innerHTML=`<div class="featured-empty"><img src="/static/smi-logo.jpg" alt="SIJAN MOD IOS"><div><span class="feature-kicker">SIJAN MOD IOS · APP COLLECTION</span><h2>${tr('featuredEmpty')}</h2><p>${tr('featuredEmptyText')}</p><a class="feature-outline" href="#apps">${tr('appCollection').replace(/<[^>]+>/g,'')} ↘</a></div></div>`;dots.innerHTML='';return}
 featuredIndex=(featuredIndex+allApps.length)%allApps.length;const a=allApps[featuredIndex],install=Boolean(a.install_url),image=a.icon_url||'/static/smi-logo.jpg';
 stage.innerHTML=`<article class="feature-card"><div class="feature-backdrop" style="--feature-image:url('${esc(image)}')"></div><div class="feature-art">${a.icon_url?`<img src="${esc(a.icon_url)}" alt="${esc(a.name)} icon">`:`<img src="/static/smi-logo.jpg" alt="SIJAN MOD IOS">`}</div><div class="feature-copy"><div class="feature-labels"><span class="feature-kicker">${tr('featured')}</span><span class="feature-status">${install?tr('ota'):tr('direct')}</span></div><span class="feature-category">${esc(a.category||'iOS APP')}</span><h2>${esc(a.name)}</h2><div class="feature-version">${tr('version')} ${esc(a.version)} <span>·</span> ${esc(a.bundle_id)}</div><p>${esc(a.description||'')}</p><a class="feature-buy" href="${esc(a.install_url||a.download_url)}"><span>${install?tr('installApp'):tr('download')}</span><b>↗</b></a></div>${allApps.length>1?`<button class="featured-arrow featured-prev" id="featuredPrev" aria-label="Previous app">‹</button><button class="featured-arrow featured-next" id="featuredNext" aria-label="Next app">›</button>`:''}</article>`;
 dots.innerHTML=allApps.map((_,i)=>`<button class="featured-dot ${i===featuredIndex?'active':''}" aria-label="Show featured app ${i+1}" data-slide="${i}"></button>`).join('');
 stage.querySelector('#featuredPrev')?.addEventListener('click',()=>{featuredIndex--;renderFeatured()});stage.querySelector('#featuredNext')?.addEventListener('click',()=>{featuredIndex++;renderFeatured()});dots.querySelectorAll('[data-slide]').forEach(b=>b.addEventListener('click',()=>{featuredIndex=Number(b.dataset.slide);renderFeatured()}));
}
function renderApps(){
 const query=document.getElementById('search').value.trim().toLowerCase();const visible=allApps.filter(a=>(filter==='all'||a.category===filter)&&(`${a.name} ${a.description} ${a.bundle_id}`.toLowerCase().includes(query)));
 document.getElementById('appCount').textContent=`${visible.length} ${document.documentElement.lang==='bn'?'অ্যাপ':'APPS'}`;
 const counts={all:allApps.length,ESign:allApps.filter(a=>a.category==='ESign').length,KSign:allApps.filter(a=>a.category==='KSign').length,Other:allApps.filter(a=>!['ESign','KSign'].includes(a.category)).length};
 document.querySelectorAll('.category-filter').forEach(b=>{b.classList.toggle('active',b.dataset.filter===filter);const n=b.querySelector('i');if(n)n.textContent=counts[b.dataset.filter]??0});
 document.getElementById('appsGrid').innerHTML=visible.length?visible.map(a=>`<article class="product-card"><div class="product-card-head"><div class="app-icon">${a.icon_url?`<img src="${esc(a.icon_url)}" alt="">`:'◈'}</div><span class="product-tag">${esc(a.category)}</span></div><div class="product-copy"><h3>${esc(a.name)}</h3><div class="version-line">${tr('version')} ${esc(a.version)} <span>·</span> ${esc(a.bundle_id)}</div><p>${esc(a.description||'')}</p></div><a class="product-action" href="${esc(a.install_url||a.download_url)}"><span>${a.install_url?tr('installApp'):tr('download')}</span><b>↗</b></a></article>`).join(''):`<div class="empty-state"><h3>${tr('noApps')}</h3><p>${tr('safeNote')}</p></div>`;
 renderFeatured();
}
function renderDns(){document.getElementById('dnsCount').textContent=`${allDns.length} ${document.documentElement.lang==='bn'?'প্রোফাইল':'PROFILES'}`;document.getElementById('dnsGrid').innerHTML=allDns.length?allDns.map(d=>`<article class="product-card dns-card"><div class="product-card-head"><div class="app-icon">${d.icon_url?`<img src="${esc(d.icon_url)}" alt="">`:'⌁'}</div><span class="product-tag">DNS PROFILE</span></div><div class="product-copy"><h3>${esc(d.name)}</h3><div class="version-line">${d.version?`${tr('version')} ${esc(d.version)}`:''}</div><p>${esc(d.description||'')}</p>${d.source?`<small class="profile-meta">Source: ${esc(d.source)}</small>`:''}${d.purpose?`<small class="profile-meta">Purpose: ${esc(d.purpose)}</small>`:''}</div><a class="product-action" href="${esc(d.download_url)}" target="_blank" rel="noopener noreferrer"><span>${tr('install')}</span><b>↗</b></a></article>`).join(''):`<div class="empty-state"><h3>${tr('noDns')}</h3></div>`}
function applyLanguage(lang){document.documentElement.lang=lang;document.querySelectorAll('[data-i18n]').forEach(el=>{const val=tr(el.dataset.i18n);if(['heroTitle','appCollection'].includes(el.dataset.i18n))el.innerHTML=val;else el.textContent=val});document.querySelectorAll('[data-placeholder]').forEach(el=>el.placeholder=tr(el.dataset.placeholder));renderApps();renderDns();localStorage.setItem('sijan-lang',lang)}
document.addEventListener('DOMContentLoaded',async()=>{
 bootStarted=performance.now();startBootParticles();setBootProgress(1);bootProgressTimer=setInterval(()=>{if(bootProgress<94)setBootProgress(bootProgress+Math.max(.35,(94-bootProgress)*.012))},110);
